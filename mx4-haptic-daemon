#!/usr/bin/env python3
"""MX Master 4 Haptic Feedback Daemon for Linux.

Sends HID++2.0 haptic commands directly to /dev/hidraw for near-instant response.
Triggers: display boundary crossing, workspace switch, window snap,
focus change (via the mx4-cursor-tracker GNOME extension), and desktop
notifications.
"""

import argparse
import copy
import glob
import logging
import os
import signal
import time

import yaml

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

HIDPP_LONG_REPORT_ID = 0x11
HIDPP_LONG_MSG_SIZE = 20  # 1 report_id + 1 device + 18 data

WAVEFORMS = {
    "SHARP_STATE_CHANGE": 0x00,
    "DAMP_STATE_CHANGE": 0x01,
    "SHARP_COLLISION": 0x02,
    "DAMP_COLLISION": 0x03,
    "SUBTLE_COLLISION": 0x04,
    "HAPPY_ALERT": 0x05,
    "ANGRY_ALERT": 0x06,
    "COMPLETED": 0x07,
    "SQUARE": 0x08,
    "WAVE": 0x09,
    "FIREWORK": 0x0A,
    "MAD": 0x0B,
    "KNOCK": 0x0C,
    "JINGLE": 0x0D,
    "RINGING": 0x0E,
    "WHISPER_COLLISION": 0x1B,
}

CONFIG_PATH = os.path.expanduser("~/.config/mx4-haptic/config.yaml")

log = logging.getLogger("mx4-haptic")

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

DEFAULT_CONFIG = {
    "device_path": "auto",
    "feature_index": 11,
    "device_number": 0xFF,
    "display_boundary": {
        "enabled": True,
        "waveform": "SUBTLE_COLLISION",
        "debounce_ms": 100,
    },
    "notifications": {
        "enabled": True,
        "waveform": "HAPPY_ALERT",
        "cooldown_s": 2,
    },
    "workspace_switch": {
        "enabled": True,
        "waveform": "SUBTLE_COLLISION",
    },
    "window_snap": {
        "enabled": True,
        "waveform": "SUBTLE_COLLISION",
        "debounce_ms": 300,
    },
    "focus_change": {
        "enabled": True,
        "waveform": "SUBTLE_COLLISION",
        "cooldown_s": 0.3,
    },
}


def load_config(config_path=CONFIG_PATH):
    cfg = copy.deepcopy(DEFAULT_CONFIG)
    try:
        with open(config_path) as f:
            user = yaml.safe_load(f)
        if user:
            for k, v in user.items():
                if isinstance(v, dict) and isinstance(cfg.get(k), dict):
                    cfg[k] = {**cfg[k], **v}
                else:
                    cfg[k] = v
    except FileNotFoundError:
        log.info("No config file at %s, using defaults", config_path)
    return cfg


# ---------------------------------------------------------------------------
# HapticSender — direct HID++ write to /dev/hidraw
# ---------------------------------------------------------------------------

def find_mx4(sysfs_root="/sys/class/hidraw"):
    """Return the /dev/hidraw* node whose HID name is MX Master 4, or None."""
    for uevent in sorted(glob.glob(os.path.join(sysfs_root, "hidraw*", "device", "uevent"))):
        try:
            with open(uevent) as f:
                fields = dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
        except OSError:
            continue
        if "MX Master 4" in fields.get("HID_NAME", ""):
            return os.path.join("/dev", uevent.split(os.sep)[-3])
    return None


class HapticSender:
    """Sends HID++2.0 haptic waveform commands via /dev/hidraw.

    The device is opened on first use and reopened after a failed write, so
    the daemon survives the mouse sleeping, reconnecting, or changing node.
    """

    FN_BYTE = 0x41  # (WRITE_FNID & 0xF0) | (SW_ID & 0x0F) = 0x40 | 0x01

    def __init__(self, device_path, feature_index, device_number):
        self.device_path = device_path  # a /dev/hidraw* path, or "auto"
        self.feature_index = feature_index
        self.device_number = device_number
        self._fd = None

    def close(self):
        if self._fd is not None:
            try:
                os.close(self._fd)
            except OSError:
                pass
            self._fd = None

    def _connect(self):
        """Open the configured path, falling back to the detected MX Master 4."""
        self.close()
        candidates = [] if self.device_path == "auto" else [self.device_path]
        found = find_mx4()
        if found and found not in candidates:
            candidates.append(found)
        for path in candidates:
            try:
                self._fd = os.open(path, os.O_RDWR)
                log.info("Opened %s", path)
                return
            except OSError as e:
                log.debug("Cannot open %s: %s", path, e)
        raise OSError("MX Master 4 not found (tried: %s)" % (", ".join(candidates) or "none"))

    def _build_packet(self, waveform_index):
        """Build a 20-byte HID++ long message for haptic play.

        Packet layout:
          [0] 0x11           — long report id
          [1] device_number  — 0xFF for BT direct
          [2] feature_index  — HAPTIC feature index on device
          [3] fn_id | sw_id  — function 4 << 4 | software_id
          [4] waveform       — waveform index byte
          [5..19] 0x00       — padding
        """
        header = bytes([HIDPP_LONG_REPORT_ID, self.device_number, self.feature_index,
                        self.FN_BYTE, waveform_index])
        return header.ljust(HIDPP_LONG_MSG_SIZE, b"\x00")

    def play(self, waveform_name):
        """Send a haptic waveform by name. Returns True on success."""
        wf = WAVEFORMS.get(waveform_name)
        if wf is None:
            log.error("Unknown waveform: %s", waveform_name)
            return False
        return self.play_index(wf)

    def play_index(self, waveform_index):
        """Send a haptic waveform by numeric index. Returns True on success."""
        pkt = self._build_packet(waveform_index)
        for attempt in range(2):
            try:
                if self._fd is None:
                    self._connect()
                os.write(self._fd, pkt)
                log.debug("Sent waveform 0x%02X", waveform_index)
                return True
            except OSError as e:
                self.close()
                if attempt == 0:
                    log.debug("Write failed (%s), reconnecting", e)
                else:
                    log.warning("Haptic not sent: %s", e)
        return False


# ---------------------------------------------------------------------------
# Triggers — D-Bus events that play a waveform
# ---------------------------------------------------------------------------

EXTENSION_IFACE = "com.mx4haptic.CursorTracker"
EXTENSION_PATH = "/com/mx4haptic/CursorTracker"

# Config section -> signal emitted by the mx4-cursor-tracker GNOME extension.
EXTENSION_SIGNALS = {
    "display_boundary": "BoundaryCrossed",
    "workspace_switch": "WorkspaceSwitched",
    "window_snap": "WindowSnapped",
    "focus_change": "FocusChanged",
}


class Trigger:
    """Plays a waveform per event, dropping events inside the throttle window."""

    def __init__(self, name, sender, tcfg):
        self.name = name
        self.sender = sender
        self.waveform = tcfg["waveform"]
        self.throttle_s = tcfg.get("cooldown_s", tcfg.get("debounce_ms", 0) / 1000.0)
        self._last = float("-inf")

    def fire(self, *args):
        now = time.monotonic()
        if now - self._last < self.throttle_s:
            return
        self._last = now
        log.info("%s: %s", self.name, ", ".join(map(str, args)))
        self.sender.play(self.waveform)


def setup_triggers(cfg, sender, bus):
    """Subscribe every enabled trigger to the session bus."""
    for key, signal_name in EXTENSION_SIGNALS.items():
        if cfg[key]["enabled"]:
            trigger = Trigger(signal_name, sender, cfg[key])
            bus.add_signal_receiver(trigger.fire, signal_name=signal_name,
                                    dbus_interface=EXTENSION_IFACE, path=EXTENSION_PATH)

    if cfg["notifications"]["enabled"]:
        trigger = Trigger("Notify", sender, cfg["notifications"])

        def on_message(_bus, msg):
            if msg.get_interface() == "org.freedesktop.Notifications" and msg.get_member() == "Notify":
                args = msg.get_args_list()
                trigger.fire(args[3] if len(args) > 3 else "?")

        bus.add_match_string(
            "type='method_call',"
            "interface='org.freedesktop.Notifications',"
            "member='Notify',"
            "eavesdrop=true"
        )
        bus.add_message_filter(on_message)

    log.info("Triggers enabled: %s",
             ", ".join(k for k in [*EXTENSION_SIGNALS, "notifications"] if cfg[k]["enabled"]))


# ---------------------------------------------------------------------------
# Test mode
# ---------------------------------------------------------------------------

def run_test(sender):
    """Play all known waveforms sequentially."""
    print("MX Master 4 Haptic Test — playing all waveforms")
    for name, idx in sorted(WAVEFORMS.items(), key=lambda kv: kv[1]):
        print(f"  [{idx:#04x}] {name}...", end=" ", flush=True)
        ok = sender.play_index(idx)
        print("OK" if ok else "FAIL")
        time.sleep(1.5)
    sender.close()
    print("Done.")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="MX Master 4 Haptic Feedback Daemon")
    parser.add_argument("--test", action="store_true", help="Play all waveforms and exit")
    parser.add_argument("--verbose", "-v", action="store_true", help="Debug logging")
    parser.add_argument("--config", default=CONFIG_PATH, help="Config file path")
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(asctime)s %(name)s %(levelname)s %(message)s",
        datefmt="%H:%M:%S",
    )

    cfg = load_config(args.config)

    dev_num = cfg.get("device_number", 0xFF)
    if isinstance(dev_num, str):
        dev_num = int(dev_num, 0)

    sender = HapticSender(
        device_path=cfg["device_path"],
        feature_index=cfg["feature_index"],
        device_number=dev_num,
    )

    if args.test:
        run_test(sender)
        return

    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    # Set up GLib main loop with D-Bus integration
    DBusGMainLoop(set_as_default=True)
    loop = GLib.MainLoop()
    bus = dbus.SessionBus()
    setup_triggers(cfg, sender, bus)

    # Signal handlers
    def on_shutdown(signum, frame):
        log.info("Received signal %d, shutting down", signum)
        loop.quit()

    signal.signal(signal.SIGTERM, on_shutdown)
    signal.signal(signal.SIGINT, on_shutdown)

    log.info("mx4-haptic-daemon started (device=%s)", cfg["device_path"])

    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    finally:
        log.info("Shutting down...")
        sender.close()
        log.info("Bye.")


if __name__ == "__main__":
    main()
