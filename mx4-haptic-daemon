#!/usr/bin/env python3
"""MX Master 4 Haptic Feedback Daemon for Linux.

Sends HID++2.0 haptic commands directly to /dev/hidraw for near-instant response.
Triggers: display boundary crossing, desktop notifications.
"""

import argparse
import copy
import errno
import logging
import os
import signal
import stat
import struct
import threading
import time

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib
import yaml

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

HIDPP_LONG_REPORT_ID = 0x11
HIDPP_LONG_MSG_SIZE = 20  # 1 report_id + 1 device + 18 data

WAVEFORMS = {
    "SHARP_STATE_CHANGE": 0x00,
    "DAMP_STATE_CHANGE": 0x01,
    "SHARP_COLLISION": 0x02,
    "DAMP_COLLISION": 0x03,
    "SUBTLE_COLLISION": 0x04,
    "HAPPY_ALERT": 0x05,
    "ANGRY_ALERT": 0x06,
    "COMPLETED": 0x07,
    "SQUARE": 0x08,
    "WAVE": 0x09,
    "FIREWORK": 0x0A,
    "MAD": 0x0B,
    "KNOCK": 0x0C,
    "JINGLE": 0x0D,
    "RINGING": 0x0E,
    "WHISPER_COLLISION": 0x1B,
}

CONFIG_PATH = os.path.expanduser("~/.config/mx4-haptic/config.yaml")

# Where hidraw nodes and their sysfs metadata live. Module-level so tests can
# point them at a fake tree.
DEV_DIR = "/dev"
SYSFS_HIDRAW_DIR = "/sys/class/hidraw"

LOGITECH_VENDOR_ID = 0x046D
TARGET_NAME = "MX Master 4"

log = logging.getLogger("mx4-haptic")

